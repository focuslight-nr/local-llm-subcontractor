#!/usr/bin/env python3
"""Send a prompt to a local LLM subcontractor and print the reply to stdout.

Usage:
  echo "prompt" | llm                          # flint, the default
  llm -m qwen3.6:35b-a3b "Write a slugify function in Python. Output only code."
  llm -m qwen -s "You output only JSON." < input.txt
  llm -m ornith-1.5:35b --think < tricky_spec.md   # reason first, then answer

-m accepts an alias (below) or any Ollama model name directly.

Exit codes (anything non-zero means no usable answer, and stdout is empty):
  0  answer written to stdout
  2  could not connect: server not running, or a sandbox is blocking localhost
  3  connected, but the request failed (HTTP error from the server, or timeout)
  4  the model returned an empty answer

Thinking is off by default: it costs several times the wall-clock and, at small
output budgets, can consume the whole allowance before answering. Use --think for
fiddly specs that direct answering gets wrong (it raises the token budget and
temperature to match). Models that cannot answer without it (flint, bonsai-2) get
it switched on automatically; --no-think forces it off for diagnosis.

All models are served by Ollama (LLM_OLLAMA_URL, default http://localhost:11434;
LLM_QWEN_URL is still honoured). Aliases (override the model with env vars):
  flint   LLM_FLINT_MODEL  (default flint:latest) - used when -m is omitted
  qwen    LLM_QWEN_MODEL   (default qwen3.6:27b)
  bonsai  LLM_BONSAI_MODEL (default bonsai-2:27b; use with --think)
  <other> treated as an Ollama model name (e.g. qwen3.6:35b-a3b)
"""
import argparse
import json
import os
import re
import socket
import sys
import urllib.error
import urllib.request

OLLAMA_URL = os.environ.get("LLM_OLLAMA_URL") or os.environ.get("LLM_QWEN_URL") \
    or "http://localhost:11434"

ALIASES = {
    "flint": os.environ.get("LLM_FLINT_MODEL", "flint:latest"),
    "qwen": os.environ.get("LLM_QWEN_MODEL", "qwen3.6:27b"),
    "bonsai": os.environ.get("LLM_BONSAI_MODEL", "bonsai-2:27b"),
}

# Models that reason whatever we ask: with thinking off that reasoning is
# discarded but still spends the output budget, so a real task ends with an
# empty answer (a one-line prompt may squeeze through). Thinking is therefore
# turned on for them unless --no-think is given. Matched by name prefix.
THINKING_REQUIRED = ("flint", "bonsai-2")

DEFAULT_SYSTEM = ("You are a precise coding assistant. Follow output format "
                  "instructions exactly. Do not think step by step; answer directly.")

# With --think the model reasons before answering, so drop the "answer directly"
# instruction that would otherwise fight the thinking phase.
THINKING_SYSTEM = ("You are a precise coding assistant. Follow output format "
                   "instructions exactly.")


def request(model, system, prompt, temperature, max_tokens, timeout, think=False):
    messages = [{"role": "system", "content": system},
                {"role": "user", "content": prompt}]
    payload = {"model": model, "messages": messages, "stream": False, "think": think,
               "options": {"temperature": temperature, "num_predict": max_tokens,
                           "num_ctx": int(os.environ.get("LLM_NUM_CTX", 16384))}}
    req = urllib.request.Request(OLLAMA_URL + "/api/chat", data=json.dumps(payload).encode(),
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        resp = json.load(r)
    # Return why generation stopped too: "length" means the token budget ran
    # out, which is how an empty answer happens when reasoning eats it all.
    return resp["message"]["content"] or "", resp.get("done_reason")


def fail(code, msg):
    sys.stderr.write(msg.rstrip("\n") + "\n")
    sys.exit(code)


def http_error_detail(e):
    """Ollama puts the useful part in a JSON body."""
    try:
        body = e.read().decode("utf-8", "replace")
        return json.loads(body).get("error") or body.strip()
    except Exception:
        return e.reason


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-m", "--model", default=os.environ.get("LLM_DEFAULT", "flint"),
                    help="backend alias ({}) or any Ollama model name".format(
                        "/".join(sorted(ALIASES))))
    ap.add_argument("-s", "--system", default=None,
                    help="system prompt (defaults suit --think automatically)")
    ap.add_argument("-t", "--temperature", type=float, default=None,
                    help="sampling temperature (default 0.2, or 1.0 with --think)")
    ap.add_argument("--think", action="store_true",
                    help="let the model reason before answering: slower, but it "
                         "solves fiddly specs that direct answering gets wrong "
                         "(already on for {})".format("/".join(THINKING_REQUIRED)))
    ap.add_argument("--no-think", dest="no_think", action="store_true",
                    help="force thinking off, even for a model that needs it "
                         "(expect an empty answer: for diagnosis only)")
    ap.add_argument("--max-tokens", type=int, default=None,
                    help="output cap (default 4000, or 12000 with --think, since "
                         "reasoning draws from the same budget)")
    ap.add_argument("--timeout", type=int, default=1800)
    ap.add_argument("prompt", nargs="*", help="prompt text (reads stdin if omitted)")
    args = ap.parse_args()

    model = ALIASES.get(args.model, args.model)
    if not args.think and not args.no_think \
            and model.startswith(THINKING_REQUIRED):
        args.think = True

    # Thinking needs its own defaults; explicit flags still win.
    if args.system is None:
        args.system = THINKING_SYSTEM if args.think else DEFAULT_SYSTEM
    if args.temperature is None:
        args.temperature = 1.0 if args.think else 0.2
    if args.max_tokens is None:
        args.max_tokens = 12000 if args.think else 4000

    prompt = " ".join(args.prompt) if args.prompt else sys.stdin.read()
    if not prompt.strip():
        ap.error("empty prompt")

    try:
        text, stop_reason = request(model, args.system, prompt, args.temperature,
                                    args.max_tokens, args.timeout, args.think)
    # HTTPError subclasses URLError, so it must come first: the server was
    # reached and answered with an error, which is not "unreachable".
    except urllib.error.HTTPError as e:
        hint = ""
        if e.code == 404:
            hint = "\nis the model pulled? try: ollama pull {}".format(model)
        elif e.code >= 500:
            hint = ("\nthe server failed mid-request (e.g. it was being upgraded or "
                    "restarted); retrying usually works")
        fail(3, "{} backend returned HTTP {}: {}{}".format(
            args.model, e.code, http_error_detail(e), hint))
    except (socket.timeout, TimeoutError):
        fail(3, "{} backend did not finish within {}s (raise --timeout, or "
                "shorten the spec)".format(args.model, args.timeout))
    except (urllib.error.URLError, ConnectionError) as e:
        reason = getattr(e, "reason", e)
        if isinstance(reason, PermissionError) or getattr(reason, "errno", None) == 1:
            hint = ("the connection was refused by the OS, not by the server: a "
                    "sandbox is blocking localhost. Grant network access and retry.")
        else:
            hint = "start it with: ollama serve   (then: ollama pull {})".format(model)
        fail(2, "cannot reach {} backend at {} ({})\n{}".format(
            args.model, OLLAMA_URL, reason, hint))

    # Belt and braces: drop any inline reasoning that slipped through.
    text = re.sub(r"<think>.*?</think>", "", text, flags=re.S).strip()
    if not text:
        # Never exit 0 with nothing to show: callers checking only for a
        # non-empty file would accept a blank answer as a success.
        why = ""
        if stop_reason == "length":
            why = (" - the {}-token budget ran out before any answer{}; raise "
                   "--max-tokens".format(args.max_tokens,
                                         " (with --think, reasoning uses it first)"
                                         if args.think else ""))
        fail(4, "{} returned an empty answer (stop reason: {}){}".format(
            args.model, stop_reason or "unknown", why))
    sys.stdout.write(text + "\n")


if __name__ == "__main__":
    main()
